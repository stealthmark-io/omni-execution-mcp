# ==============================================================================
# Omni Execution MCP - Environment Variable Template
#
# STRICT SAFETY NOTICE:
# - All keys below are optional. Unset rails operate in transparent dry-run/preview mode.
# - DO NOT place private keys here! This MCP server is 100% non-custodial and never
#   handles, signs, or broadcasts private keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Rail 1: Hyperliquid Builder Code (Perpetual Futures & Spot)
# ------------------------------------------------------------------------------
# Integrator EVM payout address for Hyperliquid builder code attribution:
HYPERLIQUID_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
# Fee in tenths of basis points (30 = 3 bps = 0.03%). Max perp cap: 100 (0.10%), max spot cap: 1000 (1.00%)
HYPERLIQUID_BUILDER_TENTHS_BPS=30

# ------------------------------------------------------------------------------
# Rail 2: Jupiter v6 Referral (Solana Swaps)
# ------------------------------------------------------------------------------
# Solana Token / Referral Account public key for platform fees:
JUPITER_REFERRAL_ACCOUNT=11111111111111111111111111111111
# Referral fee in basis points (5 = 0.05%, max safety cap: 100 bps = 1.00%)
JUPITER_FEE_BPS=5

# ------------------------------------------------------------------------------
# Rail 3: LI.FI Cross-Chain FeeForwarder (EVM & Solana Bridges)
# ------------------------------------------------------------------------------
# Integrator identifier registered with LI.FI:
LIFI_INTEGRATOR_ID=omni-execution-mcp
# Fee in basis points (5 = 0.05% -> passed as 0.0005 to /v1/quote, max cap: 100 bps)
LIFI_FEE_BPS=5

# ------------------------------------------------------------------------------
# Rail 4: CoW Protocol MEV-Safe Partner Fee (Batch Auctions)
# ------------------------------------------------------------------------------
# EVM address receiving surplus / partner fee from CoW batch auctions:
COW_PARTNER_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
# Partner fee in basis points (5 = 0.05%, max safety cap: 100 bps)
COW_PARTNER_FEE_BPS=5

# ------------------------------------------------------------------------------
# Rail 5: Polymarket Builder Program (Prediction Market CLOB)
# ------------------------------------------------------------------------------
# Official Builder Program credentials (used ONLY to sign HMAC attribution headers):
POLY_BUILDER_API_KEY=00000000-0000-0000-0000-000000000000
POLY_BUILDER_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
POLY_BUILDER_PASSPHRASE=builder_passphrase_placeholder

# ------------------------------------------------------------------------------
# Rail 6: 0x Swap API v2 (EVM DEX Aggregation)
# ------------------------------------------------------------------------------
# EVM recipient address for affiliate swap fee:
ZEROX_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
# Swap affiliate fee in basis points (5 = 0.05%, max safety cap: 100 bps)
ZEROX_FEE_BPS=5
